# 生产环境变量清单（只是模板，不得原样启动）。
# 将真实密钥注入部署平台的 Secret，不要把复制后的文件提交到 Git 或烘焙进镜像。
# 该文件是变量总目录；正式部署应按 docs/backend-production-runbook.md 为各进程拆分最小权限配置。

NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# 必填且不得为空；必须显式写出 host、user、port 和唯一数据库名（password 可省略），不能由 PGPORT 等环境变量补齐；production 不会回退本地开发 DSN。远程 PostgreSQL 必须开启 SSL，证书链需被运行时系统信任。
DATABASE_URL=
DATABASE_SSL=true
# 各角色可按容量独立设置连接池；API/Worker 的 statement/lock/idle-transaction 默认值如下。
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

# 仅 Migration Job 使用。生产迁移前必须排空全部 API、Generation/Export/Payment Worker
# 与清理任务，先在网关/平台阻止新连接，再确认同库所有数据库角色均无其他
# client backend 连接后才可设为 true；一次预检不能替代持续的连接阻断，迁移完成即移除。
PINDOU_MIGRATION_MAINTENANCE_ACKNOWLEDGED=false

# 仅 API 使用。这里是单进程上限；多副本总上限需由容量规划或分布式限流协调。
EXPORT_DOWNLOAD_GLOBAL_CONCURRENCY=4
EXPORT_DOWNLOAD_PER_USER_CONCURRENCY=2
EXPORT_DOWNLOAD_READ_TIMEOUT_MS=60000
EXPORT_DOWNLOAD_WRITE_TIMEOUT_MS=120000

# 生产环境不允许开发登录，也绝不允许 Web poll token 的本地 Bearer 兼容。CORS 只列出确实需要的 Web 来源，不要使用 *。
DEV_AUTH_ENABLED=false
CORS_ORIGINS=https://console.example.com
# 必填：只列反向代理/负载均衡器的源 IP 或 CIDR，逗号分隔；禁止使用全网段。
TRUSTED_PROXIES=
# 首次部署保持 false；完成 0031/0032 迁移、全部 owner-aware 新节点就绪并排空所有旧节点后才可改为 true。
# 一旦产生私有色卡，关闭此开关也不能安全回滚到缺少 owner 过滤的旧镜像。
CUSTOM_PALETTES_ENABLED=false
SESSION_TTL_DAYS=30
DEV_STARTING_CREDITS=0

# 当前 active/write 密钥及其不可复用 ID。API、两个 Worker 和两个清理任务必须使用同一完整 keyring。
# 新部署可让 LEGACY_KEY_ID 等于 ACTIVE_KEY_ID；轮换后它应继续指向可解密 PDAE1 的旧密钥。
ASSET_ENCRYPTION_KEY_BASE64=
ASSET_ENCRYPTION_ACTIVE_KEY_ID=replace-with-immutable-key-id
ASSET_ENCRYPTION_READ_KEYS_JSON={}
ASSET_ENCRYPTION_LEGACY_KEY_ID=replace-with-immutable-key-id
# API、Generation/Export Worker 与两个 Purge 角色在生产环境必须显式设置 provider；推荐 s3。
ASSET_STORAGE_PROVIDER=s3
# 仅有受控单实例且已挂载持久卷时才可改为 local。届时必须填写绝对、非文件系统根目录路径，并把风险确认改为 true。
ASSET_STORAGE_ROOT=
ASSET_LOCAL_STORAGE_PRODUCTION_ACKNOWLEDGED=false
ASSET_S3_BUCKET=
ASSET_S3_REGION=
# AWS S3 留空；MinIO 填写无路径的 HTTPS endpoint。
ASSET_S3_ENDPOINT=
ASSET_S3_PREFIX=pindou/prod/private
ASSET_S3_FORCE_PATH_STYLE=false
# 优先使用容器/实例角色的默认凭据链。仅在必须显式配置时才注入以下变量。
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_SESSION_TOKEN=

ASSET_MAX_BYTES=10485760
ASSET_DEFAULT_TTL_HOURS=23
ASSET_CONSENT_VERSION=privacy-v1
# 三项均为 API 启动必填；填写经隐私/法务确认的处理方、用户可读用途和保留说明，禁止沿用开发占位值。
ASSET_CONSENT_PROCESSOR=
ASSET_CONSENT_PURPOSE_TEXT=
ASSET_CONSENT_RETENTION_TEXT=
ASSET_PURGE_BATCH_SIZE=500
ASSET_PURGE_MAX_BATCHES=100

# 至少 32 个字符，仅 API 和获准调用内部 HTTP 端点的主体可见。
INTERNAL_WORKER_KEY=

# 只注入 Generation Worker；生产 URL 必须是 HTTPS。
GENERATION_PROVIDER_URL=
GENERATION_PROVIDER_API_KEY=
GENERATION_PROVIDER_TIMEOUT_MS=120000

# 以下完整微信配置注入 API；当前支付对账 Worker 复用同一 payment Provider factory，
# 因此也必须注入这一整组配置。私钥/验签公钥文件以只读 Secret volume 挂载。
# AppSecret、API v3 key 和 notify URL 对查单/关单本身不是最小必需项，但在拆分专用 factory 前仍是启动必填。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_CERT_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
WECHAT_PAY_VERIFIER_SERIAL=
WECHAT_PAY_VERIFIER_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public_key.pem
# 可选；两阶段轮换期间同时信任旧/新 serial，完成切换后再移除旧项。最多 8 个。
WECHAT_PAY_ADDITIONAL_VERIFIERS=
# 必须恰好为 32 个 UTF-8 字节。
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/wechat-pay/notifications

# 独立支付对账 Worker 的租约、未支付复查间隔和空队列轮询间隔（毫秒）。
PAYMENT_RECONCILIATION_LEASE_MS=60000
PAYMENT_RECONCILIATION_POLL_MS=60000
PAYMENT_RECONCILIATION_IDLE_MS=750

# CloudBase PG Storage (set ASSET_STORAGE_PROVIDER=cloudbase-pg to enable).
ASSET_CLOUDBASE_ENV_ID=
ASSET_CLOUDBASE_BUCKET_ID=
ASSET_CLOUDBASE_SERVICE_ROLE_API_KEY=
